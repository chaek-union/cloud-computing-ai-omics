direction: down

user: "User\n자연어 질문" {
  shape: person
  style.fill: "#FFE9BF"
  style.stroke: "#FF9900"
  style.stroke-width: 3
  style.font-size: 13
  style.font-color: "#8F5500"
}

natural_language: {
  label: "Natural language\n\nBedrock · Claude · AgentCore\n자연어 ↔ SQL 번역, 보고서 요약, 설명 생성"
  style.fill: "#FCE4EC"
  style.stroke: "#CC2264"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 14
  style.font-color: "#232F3E"
}

query: {
  label: "Query layer\n\nAthena · Glue catalog · S3 Tables\n재현 가능한 SQL 질의 · provenance 추적"
  style.fill: "#EFE4FF"
  style.stroke: "#8C4FFF"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 14
  style.font-color: "#232F3E"
}

annotation: {
  label: "Annotation\n\nHealthOmics · VEP · ClinVar · OMIM\n변이의 기능적·임상적 의미를 필드로 만든다"
  style.fill: "#FFF3E0"
  style.stroke: "#FF9900"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 14
  style.font-color: "#232F3E"
}

raw: {
  label: "Raw data\n\nVCF · sample metadata on S3"
  style.fill: "#F3F8EC"
  style.stroke: "#7AA116"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 14
  style.font-color: "#232F3E"
}

user -> natural_language: "자연어 질문" {
  style.stroke: "#FF9900"
  style.stroke-width: 3
  style.font-size: 11
  style.italic: true
}

