direction: down

vars: {
  d2-config: {
    layout-engine: elk
  }
}

vcf: "VCF (project-wide, dense)\n\n모든 샘플 × 모든 위치를\n펼쳐 저장\n(변이 없는 칸도 0/0으로 기록)" {
  style.fill: "#FDF3E7"
  style.stroke: "#D13212"
  style.stroke-width: 3
  style.border-radius: 8
  style.font-size: 22
  style.font-color: "#8B1C00"
  style.bold: true
}

vds: "VDS (sparse, split)" {
  style.fill: "#F2F3F3"
  style.stroke: "#232F3E"
  style.stroke-width: 2
  style.border-radius: 8
  style.font-size: 22
  style.bold: true

  variant: "variant_data\n(sparse)\n\n실제 변이만 저장" {
    style.fill: "#E7F1FF"
    style.stroke: "#146EB4"
    style.stroke-width: 3
    style.border-radius: 8
    style.font-size: 20
    style.font-color: "#0F4C81"
    style.bold: true
  }

  reference: "reference_data\n(block summary)\n\npos 1–10: AN = 2N\npos 11–20: AN = 2N" {
    style.fill: "#F3F8EC"
    style.stroke: "#7AA116"
    style.stroke-width: 3
    style.border-radius: 8
    style.font-size: 20
    style.font-color: "#4F6B0C"
    style.bold: true
  }
}

size: "gnomAD v4.0 (955,213 samples) 기준 저장 크기" {
  style.fill: "#FFFFFF"
  style.stroke: "#D4D9DE"
  style.stroke-dash: 4
  style.font-size: 22
  style.bold: true

  vcf_bar: "VCF: 약 897 TB" {
    width: 900
    height: 80
    style.fill: "#FADBD1"
    style.stroke: "#D13212"
    style.stroke-width: 3
    style.font-size: 28
    style.font-color: "#8B1C00"
    style.bold: true
  }

  vds_bar: "VDS: 약 18 TB" {
    width: 100
    height: 80
    style.fill: "#D9E7BD"
    style.stroke: "#7AA116"
    style.stroke-width: 3
    style.font-size: 22
    style.font-color: "#4F6B0C"
    style.bold: true
  }
}

vcf -> vds: "같은 정보, 다른 표현" {
  style.stroke: "#232F3E"
  style.stroke-width: 2
  style.font-size: 18
  style.italic: true
}
